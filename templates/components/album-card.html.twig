
        
            <div class="col-md-3 mb-4">
                <div class="card h-100">
                    <img src="{{ asset(al.imagePath) }}" class="card-img-top">
                    <div class="card-body">
                        <p class="card-text">Titre de l'album : {{ al.title }}</p>
                        <p class="card-text">Type de l'album : {{ al.type }}</p>
                        <p class="card-text">Artiste : {{ al.artist.name }}</p>
                        <p class="card-text">Date de sortie : {{ al.releaseAt|date('d/m/Y') }}</p>
                        <p class="card-text">Pays d'origine : {{ al.artist.countryOrigin }}</p>
                        <a href="{{path('app_item', {'id' : al.id })}}" class="btn btn-primary mt-auto">Voir l'album</a>
                    </div>
                </div>
            </div>