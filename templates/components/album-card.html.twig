
        
            <div class="col-md-3 mb-4">
                <div class="card h-100">
                    <img src="{{ asset(al.imagePath) }}" class="card-img-top">
                    <div class="card-body">
                        <p class="card-text"><strong>N°:</strong> {{ loop.index }}</p>
                        <p class="card-text"><strong>Titre de l'album :</strong> {{ al.title }}</p>
                        <p class="card-text"><strong>Type de l'album : </strong>{{ al.type }}</p>
                        <p class="card-text"><strong>Artiste : </strong>{{ al.artist.name }}</p>
                        <p class="card-text"><strong>Date de sortie : </strong>{{ al.releaseAt|date('d/m/Y') }}</p>
                        <p class="card-text"><strong>Pays d'origine :</strong> {{ al.artist.countryOrigin }}</p>
                        <a href="{{path('app_item', {'id' : al.id })}}" class="btn btn-primary mt-auto">Voir l'album</a>
                    </div>
                </div>
            </div>