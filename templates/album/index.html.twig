{% extends 'base.html.twig' %}

{% block title %}Hello AlbumController!{% endblock %}

{% block body %}

    <h2>Les albums</h2>
    <div class="row">
        {% for al in albumtype %}
            {% include 'components/album-card.html.twig' with {al:al}%}
        {% endfor %}
    </div>

    <h2>Les albums SINGLE</h2>


    <div class="row">
        {% for s in singletype %}
             {% include 'components/album-card.html.twig' with {al:s}%}
        {% endfor %}
    </div>

    <h2>Les albums EP</h2>


    <div class="row">
        {% for ep in eptype %}
             {% include 'components/album-card.html.twig' with {al:ep}%}
        {% endfor %}
    </div>
{% endblock %}
