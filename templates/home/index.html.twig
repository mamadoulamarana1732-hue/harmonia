{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}

    <h2>Les albums disponibles</h2>

    <div class="row">
        {% for album in albumEntities %}
            <div class="col-md-3 mb-4">
                <div class="card h-100">
                    <img src="{{ asset(album.imagePath) }}" class="card-img-top">
                    <div class="card-body">
                        <p class="card-text">ID : {{ album.id }}</p>
                        <p class="card-text"><strong>Titre de l'album :</strong> {{ album.title }}</p>
                        <p class="card-text"><strong>Artiste :</strong> {{ album.artist.name }}</p>
                        <a href="{{path('app_item', {'id' : album.id })}}" class="btn btn-primary mt-auto">Voir l'album</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

{% endblock %}