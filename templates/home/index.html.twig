{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
    <h2>Les albums disponibles</h2>

    <div class="row">
        {% for album in albumEntities %}
            <div class="col-md-3 mb-4">
                <div class="card h-100">
                    <img src="{{ asset(album.imagePath) }}" class="card-img-top" alt="{{ album.title }}">
                    <div class="card-body">
                        <p class="card-text">Titre de l'album : {{ album.title }}</p>
                        <p class="card-text">Artiste : {{ album.artist.name }}</p>
                        <p class="card-text">Date de sortie : {{ album.releaseAt|date('d/m/Y') }}</p>
                        <p class="card-text">Pays d'origine : {{ album.artist.countryOrigin }}</p>
                        <a href="#" class="btn btn-primary mt-auto">Musique</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

{% endblock %}