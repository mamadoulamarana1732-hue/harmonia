{% extends 'base.html.twig' %}

{% block title %}Item {% endblock %}

{% block body %}


            <div class="row">
            <div class="col-md-4">
                
                <div class="card h-100">
                <a href="{{ path('app_son_create', {'albumid': album.id}) }}" class="btn btn-primary mt-auto">Ajouter Une Musique</a>
                    <img src="{{ asset(album.imagePath) }}" class="card-img-left">
                    <div class="card-body">
                        {# <p class="card-text">N°: {{ loop.index }}</p> #}
                        <p class="card-text">Titre de l'album : {{ album.title }}</p>
                        <p class="card-text">Type de l'album : {{ album.type }}</p>
                        <p class="card-text">Artiste : {{ album.artist.name }}</p>
                        <p class="card-text">Date de sortie : {{ album.releaseAt|date('d/m/Y') }}</p>
                        <p class="card-text">Pays d'origine : {{ album.artist.countryOrigin }}</p>
                        
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <table class="table">
                    <thead>
                        <tr>
                            <th>N°</th>
                            <th>Titre</th>
                            <th>Durée</th>
                            <th>Écoutes</th>
                             <th colspan="2">Action</th> 
                        </tr>
                    </thead>
                    <tbody>
                        {% for son in album.sons %}
                            <tr>
                                <td>{{ loop.index }}</td>
                                <td>{{ son.title }}</td>
                                <td>{{ son.duration |date('d/m/Y') }}</td>
                                <td>{{ son.counter }}</td>
                                <td><a href="">❤️</a></td> 
                                <td><a href="">delete</a></td> 
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
            </div>

{% endblock %}